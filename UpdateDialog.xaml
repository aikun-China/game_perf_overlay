<Window x:Class="PerfMonitor.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="520" Height="420"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="VersionText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UpdateButton" Content="更新" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Update_Click"/>
            <Button Content="取消" Width="88" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
